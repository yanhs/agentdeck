# AgentDeck guests — settings. Copy to guests/.env (guests/install.sh does it once) and
# fill in. guests/.env is never committed and never goes into an image. A variable set in
# the environment of a command wins over this file. Check: python3 guests/guestctl.py doctor

# The domain for the guests' addresses (required):
#   sb-<guest>.<domain>      each guest's dashboard (password-protected AgentDeck)
#   sbx.<domain>             files guests hand out by link
#   <site>-<guest>.<domain>  sites guests publish from their sandbox
GUESTS_DOMAIN=

# The shared guest bot: create it with @BotFather. Only the host's Telegram turnstile
# holds this token; each sandbox gets a pass of its own instead.
GUEST_BOT_TOKEN=

# Your Telegram user id (a number; @userinfobot tells it). Invitations ("Masha wants
# access. Let her in?") and alerts come to you through the guest bot.
OWNER_TG_ID=

# This server's public IPv4 — DNS records point here. Empty: detected via api.ipify.org.
SERVER_IP=

# DNS: with a Cloudflare API token (permission Zone.DNS:Edit) every guest's name is created
# on demand (proxied A record). Without the token file, make a wildcard A record
# *.<domain> -> SERVER_IP yourself. The file holds only the token.
#CF_TOKEN_FILE=~/.cf_token
# The Cloudflare zone, when it is not GUESTS_DOMAIN itself (e.g. GUESTS_DOMAIN=guests.example.com)
#CF_ZONE=example.com

# How alerts reach you. Empty: a message from the guest bot to OWNER_TG_ID. Or any bash
# command; the text is "$1", e.g.:
#GUESTS_NOTIFY_CMD=curl -s -d chat_id=123 --data-urlencode text="$1" https://api.telegram.org/bot<token>/sendMessage

# The sandbox image. Empty: agentdeck-guest:<AgentDeck version>, built by guests/install.sh.
#GUEST_IMAGE=
