[Unit]
Description=AgentDeck guests: Claude turnstile (owner's subscription behind guest passes)
After=network-online.target

[Service]
Environment=TURNSTILE_BIND=172.31.250.1
Environment=TURNSTILE_PORT=8790
ExecStart=/usr/bin/python3 -I /home/ubuntu/pr/agentdeck-guests/turnstile/turnstile.py serve
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
