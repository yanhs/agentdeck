# Template: guests/install.sh fills in @USER@ / @HOME@ / @GUESTS_DIR@ and writes it to
# /etc/systemd/system. Settings come from @GUESTS_DIR@/.env (read by the program itself).
[Unit]
Description=AgentDeck guests: Claude turnstile (owner's subscription behind guest passes)
After=network-online.target docker.service sbx-firewall.service
Wants=network-online.target

[Service]
User=@USER@
Environment=HOME=@HOME@
Environment=TURNSTILE_BIND=172.31.250.1
Environment=TURNSTILE_PORT=8790
ExecStart=/usr/bin/python3 -I "@GUESTS_DIR@/turnstile/turnstile.py" serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
