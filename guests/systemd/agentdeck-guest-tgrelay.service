# Template: guests/install.sh fills in @USER@ / @HOME@ / @GUESTS_DIR@ and writes it to
# /etc/systemd/system. Settings come from @GUESTS_DIR@/.env (read by the program itself).
[Unit]
Description=AgentDeck guests: Telegram turnstile (real bot token stays on the host)
After=network-online.target docker.service sbx-firewall.service
Wants=network-online.target

[Service]
User=@USER@
Environment=HOME=@HOME@
Environment=TGRELAY_BIND=172.31.250.1
Environment=TGRELAY_PORT=8792
ExecStart=/usr/bin/python3 -I "@GUESTS_DIR@/tgrelay/tgrelay.py"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
