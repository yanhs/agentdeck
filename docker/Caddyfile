# AgentKennel proxy for `docker compose up`. Login is managed by the app (status_server):
# first visit sets the password, and there's a Change-password page. Caddy asks
# status_server /check whether the session cookie is valid; if not -> redirect to /login.
# Set AGENTKENNEL_SITE to a domain (or <ip>.sslip.io) for automatic HTTPS.
{
	email {$AGENTKENNEL_EMAIL:you@example.com}
}

{$AGENTKENNEL_SITE::8765} {
	root * /app/web

	route {
		# login / change-password pages + the auth probe — reachable without a session
		handle /login* {
			reverse_proxy 127.0.0.1:3046
		}
		handle /logout* {
			reverse_proxy 127.0.0.1:3046
		}
		handle /change-password* {
			reverse_proxy 127.0.0.1:3046
		}

		# the tab / bookmark / home-screen icon: public, so the login page shows it too
		@icons path /favicon.svg /favicon.ico /apple-touch-icon.png
		handle @icons {
			file_server
		}

		# gate everything else: valid session cookie required, else redirect to /login
		forward_auth 127.0.0.1:3046 {
			uri /check
			@unauth status 401
			handle_response @unauth {
				header Location /login
				respond 302
			}
		}

		# Session library: ONE ttyd for every topic (/sess/?arg=<id> -> open-session.sh <id>,
		# ?arg=shell -> the shared command line). ttyd runs with --base-path /sess, so the
		# prefix is kept (handle, not handle_path). Caddy passes Host through unchanged,
		# which ttyd -O compares with the websocket's Origin.
		redir /sess /sess/?{query}
		handle /sess/* {
			reverse_proxy 127.0.0.1:3031
		}
		# the library's registry API (status_server) — full path kept: /api/library/...
		handle /api/library* {
			reverse_proxy 127.0.0.1:3011
		}

		# Server tab (web/server.html): CPU / RAM of agents, sites and jobs — status_server
		handle /api/server {
			reverse_proxy 127.0.0.1:3011
		}

		# a guest's sandbox: today's Claude spend against the daily limit — status_server
		handle /api/quota {
			reverse_proxy 127.0.0.1:3011
		}

		# Server tab, Services block: the services keeper's list, log and buttons — status_server
		handle /api/services* {
			reverse_proxy 127.0.0.1:3011
		}

		# Server tab, Guests block: the optional guests module (guests/guestctl.py) — status_server
		handle /api/guests* {
			reverse_proxy 127.0.0.1:3011
		}

		# Telegram-bot setup page (status_server, behind the login gate)
		handle /telegram* {
			reverse_proxy 127.0.0.1:3011
		}

		# task board (the 📋 Tasks button) — its own backend on :9308
		redir /tasks /tasks/
		handle_path /tasks/* {
			reverse_proxy 127.0.0.1:9308
		}

		handle_path /api/terminal-status* {
			reverse_proxy 127.0.0.1:3011
		}
		handle_path /api/tmux-buffer/* {
			reverse_proxy 127.0.0.1:3045
		}
		handle_path /api/page-version* {
			reverse_proxy 127.0.0.1:3014
		}
		handle_path /api/paste-image* {
			reverse_proxy 127.0.0.1:3047
		}
		# 📎 File uploads (status_server, same port as the image paste) — full path kept
		handle /api/upload* {
			reverse_proxy 127.0.0.1:3047
		}
		# HTML revalidates every time: after logout the browser must ask again
		# (and get the login redirect) instead of showing a cached, dead dashboard
		@html path / /*.html
		header @html Cache-Control "no-cache"
		file_server
	}
}
