# Copy to .env and fill in.

# ── Dashboard login (start.sh / docker compose) ──────────────────────────────
# Docker: `docker compose` reads a .env next to docker-compose.yml AUTOMATICALLY, so every
# line here that isn't commented out is applied. Leave the three below unset for Docker:
# the first visit asks you to set a password, and the default is plain http on :8765.
# AGENTDECK_PASSWORD=change-me      # Docker: leave unset (optional pre-seed of the password)
# AGENTDECK_USER=admin              # Docker: leave unset (the username is not used there)
# Your domain → automatic HTTPS (point its DNS at the VPS first), or ":8765" for plain http.
# AGENTDECK_SITE=agents.example.com # Docker: leave unset (= ":8765")
AGENTDECK_EMAIL=you@example.com
# AGENTDECK_PORT=8765               # Docker: the outside port (default 8765)

# ── Telegram bridge (tg_bridge.py) — optional ────────────────────────────────
# Owner-only: the bridge ignores every chat except TG_BRIDGE_OWNER.
TG_BRIDGE_TOKEN=123456:your-bot-token-from-BotFather   # from @BotFather
TG_BRIDGE_OWNER=123456789                              # your numeric Telegram user id
# Where uploaded files are stored + the public base URL they're served at (optional:
# default .sessions/tgfiles and no URL — the reply then carries the local path):
# TG_FILES_DIR=/path/to/uploads
# TG_FILES_URL=https://example.com/files
# TG_WHISPER_PY=/path/to/venv/bin/python                # a python with faster-whisper (voice)
