# Reverse proxy + login for `./start.sh` (no Docker). status_server manages the password:
# you set it on first visit, and there's a Change-password page. Caddy asks /check whether
# the session cookie is valid; if not -> redirect to /login. Set AGENTDECK_SITE to a domain
# (or <ip>.sslip.io) for automatic HTTPS; default is plain http on :8765.
{
	email {$AGENTDECK_EMAIL:you@example.com}
}

{$AGENTDECK_SITE::8765} {
	root * web

	route {
		# login / change-password pages + the auth probe — reachable without a session
		handle /login* {
			reverse_proxy 127.0.0.1:3046
		}
		handle /logout* {
			reverse_proxy 127.0.0.1:3046
		}
		handle /change-password* {
			reverse_proxy 127.0.0.1:3046
		}

		# gate everything else: valid session cookie required, else redirect to /login
		forward_auth 127.0.0.1:3046 {
			uri /check
			@unauth status 401
			handle_response @unauth {
				header Location /login
				respond 302
			}
		}

		# Session library: ONE ttyd for every topic (/sess/?arg=<id> -> open-session.sh <id>,
		# ?arg=shell -> the shared command line). ttyd runs with --base-path /sess, so the
		# prefix is kept (handle, not handle_path). Caddy passes Host through unchanged,
		# which ttyd -O compares with the websocket's Origin.
		redir /sess /sess/?{query}
		handle /sess/* {
			reverse_proxy 127.0.0.1:3031
		}
		# the library's registry API (status_server) — full path kept: /api/library/...
		handle /api/library* {
			reverse_proxy 127.0.0.1:3011
		}

		# Server tab (web/server.html): CPU / RAM of agents, sites and jobs — status_server
		handle /api/server {
			reverse_proxy 127.0.0.1:3011
		}

		# Telegram-bot setup page (status_server, behind the login gate)
		handle /telegram* {
			reverse_proxy 127.0.0.1:3011
		}

		# task board (the 📋 Tasks button) — its own backend on :9308
		redir /tasks /tasks/
		handle_path /tasks/* {
			reverse_proxy 127.0.0.1:9308
		}

		handle_path /api/terminal-status* {
			reverse_proxy 127.0.0.1:3011
		}
		handle_path /api/tmux-buffer/* {
			reverse_proxy 127.0.0.1:3045
		}
		handle_path /api/page-version* {
			reverse_proxy 127.0.0.1:3014
		}
		handle_path /api/paste-image* {
			reverse_proxy 127.0.0.1:3047
		}
		file_server
	}
}
